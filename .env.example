# ============================================================================
#  ChadWallet — Environment Variables
#  Copy this file to `.env` and fill in the values. NEVER commit `.env`.
#  All keys are read at build time via app.config / expo-constants.
#  Public-safe keys are prefixed EXPO_PUBLIC_ (bundled into the app).
#  Secret keys (Birdeye/Codex) should live ONLY in the Cloudflare Worker.
# ============================================================================

# --- Privy (Auth + Embedded Wallet) -----------------------------------------
# Dashboard: https://dashboard.privy.io  -> App settings
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# --- Solana network: "devnet" (default, test first) or "mainnet" ------------
EXPO_PUBLIC_SOLANA_NETWORK=devnet

# --- Alchemy RPC (https://dashboard.alchemy.com) ----------------------------
# Create one Solana Devnet app and one Solana Mainnet app; paste the API keys.
EXPO_PUBLIC_ALCHEMY_DEVNET_KEY=
EXPO_PUBLIC_ALCHEMY_MAINNET_KEY=

# --- Cloudflare Worker proxy (hides Birdeye/Codex keys) ---------------------
# Deploy /cloudflare/worker.js then paste its URL, e.g.
# https://chadwallet-proxy.<your-subdomain>.workers.dev
EXPO_PUBLIC_API_PROXY_URL=

# --- Supabase (auth/data backup) --------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- DEV-ONLY direct keys (optional) ----------------------------------------
# Use these to run locally BEFORE deploying the Cloudflare Worker. Leave the
# proxy URL above blank and the app will call Birdeye/Codex directly with these.
# For production, deploy the worker and leave these blank so keys never ship.
EXPO_PUBLIC_DEV_BIRDEYE_KEY=
EXPO_PUBLIC_DEV_CODEX_KEY=

# ============================================================================
#  SECRET keys — DO NOT bundle into the app. Set these as Cloudflare Worker
#  secrets (`wrangler secret put BIRDEYE_API_KEY`). Listed here for reference.
# ============================================================================
# BIRDEYE_API_KEY=          # https://birdeye.so  (free tier)
# CODEX_API_KEY=            # https://codex.io    (free tier — DO NOT pay the $1)
